TELEGRAM_BOT_TOKEN=
TELEGRAM_API_ID=<test account api_id>
TELEGRAM_API_HASH=<test account api_hash>

CLIENT_SESSION=<generate via make generate-client-session>
BOT_SESSION=<generate via make make generate-bot-session>

OPENAI_API_KEY="your_api_key_here"

DB_CONNECTION_STRING="postgresql+asyncpg://..."
DB_MIGRATION_CONNECTION_STRING="postgresql://..."

ADMIN=<id_of_a_user, it's safe for the account, so you can use your own>

AGGREGATOR_CHANNEL=<channel for aggregation aka destination channel>

UPDATE_WHITELISTED_CHANNELS_INTERVAL=300

TIMEZONE="Europe/Belgrade"
